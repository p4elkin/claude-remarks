<idea-plugin>
    <id>dev.sasha.clauderemarks</id>
    <name>Claude Remarks</name>
    <vendor>sasha</vendor>
    <description><![CDATA[
        Attach short remarks to line ranges while reading code, then hand them all to a
        Claude Code session as one prompt. Remarks never touch the source files.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Needed for ShowDiffAction, which opens the real diff for the files a review names.
         A hard dependency, not optional: every JetBrains IDE ships VCS. -->
    <depends>com.intellij.modules.vcs</depends>
    <!-- The markdown preview: a remark written on the rendered page instead of on the source.
         Optional on purpose, and it has to be. The markdown plugin is bundled in every JetBrains
         IDE, but a person can disable it, and a hard dependency would then stop this whole plugin
         from loading — with no dialog and no visible error, the only symptom being that the tool
         window is not there. Everything that names a markdown class or group id lives in the config
         file, never here. -->
    <depends optional="true" config-file="claude-remarks-markdown.xml">org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The id is part of the plugin's public interface: the platform derives the action id
             ActivateClaudeRemarksToolWindow from it, and the README documents that id for IdeaVim
             mappings. Renaming this breaks every user's .ideavimrc without any error. -->
        <toolWindow id="Claude Remarks"
                    anchor="right"
                    factoryClass="dev.sasha.clauderemarks.ui.RemarksToolWindowFactory"/>
        <intentionAction>
            <className>dev.sasha.clauderemarks.action.AddRemarkIntention</className>
            <category>Claude Remarks</category>
        </intentionAction>
        <postStartupActivity implementation="dev.sasha.clauderemarks.editor.RemarkGutterStartup"/>
        <httpRequestHandler implementation="dev.sasha.clauderemarks.review.ReviewRestService"/>
        <applicationConfigurable instance="dev.sasha.clauderemarks.settings.RemarkSettingsConfigurable"
                                 id="dev.sasha.clauderemarks.settings"
                                 displayName="Claude Remarks"
                                 parentId="tools"/>
        <notificationGroup id="Claude Remarks" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="ClaudeRemarks.AddRemark"
                class="dev.sasha.clauderemarks.action.AddRemarkAction"
                text="Add Claude Remark"
                description="Attach a remark to the selected lines">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- A diff pane does NOT use EditorPopupMenu. The platform gives it its own group,
                 Diff.EditorPopupMenu, which ships empty. Without this line the item is missing
                 from the right-click menu in a diff, and the only way in is the shortcut. -->
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift R"/>
        </action>
        <!-- The same publish as the tool window's toolbar button, so publishing does not need the
             tool window to be open. No default keystroke: this is a keymap entry the user assigns.

             The id keeps the word CopyAll even though the class and the text now say Publish.
             README.md documents this id as a public interface that will not be renamed, and
             ActionIdsTest pins it. Renaming ClaudeRemarks.CopyAll would break every .ideavimrc
             mapping to it silently: IdeaVim's ":action" fails on an unknown id inside IdeaVim,
             not here, so nothing in this project would ever notice. -->
        <action id="ClaudeRemarks.CopyAll"
                class="dev.sasha.clauderemarks.action.PublishAllRemarksAction"
                text="Publish Unread Claude Remarks"
                description="Render every remark that has not been read into one markdown prompt and put it on the clipboard">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- Same reachability as ClaudeRemarks.CopyAll, and the same reason for no default
             keystroke: this is a keymap entry the user assigns. -->
        <action id="ClaudeRemarks.SendToWaiting"
                class="dev.sasha.clauderemarks.review.SendReviewAction"
                text="Send Claude Remarks to the Waiting Session"
                description="Write every pending remark to the file the waiting Claude Code session is polling for">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
